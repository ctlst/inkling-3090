+"""SM86 compact expert dispatch, adapted from our Muse kernels competition work for one GPU."""
+import torch
+from .verify_route import pack_verify
+from vllm.triton_utils import tl, triton
+
+@triton.jit
+def _one(Ids, Sorted, Experts, Padded, R:tl.constexpr, BM:tl.constexpr, BW:tl.constexpr):
+    slots=tl.arange(0,R)
+    ids=tl.load(Ids+slots)
+    # Top-k output IDs are unique per token. The dummy/padding row has all -1.
+    valid=ids>=0
+    rank=tl.cumsum(valid.to(tl.int32),0)-1
+    offsets=tl.arange(0,BW)
+    tl.store(Experts+rank,ids,mask=valid)
+    tl.store(Sorted+rank[:,None]*BM+offsets[None,:],tl.where(offsets[None,:]==0,slots[:,None],R),mask=valid[:,None] & (offsets[None,:]<BM))
+    tl.store(Padded,tl.sum(valid.to(tl.int32),0)*BM)
+
+@triton.jit
+def _group(Ids, Buckets, Counts, R:tl.constexpr, BR:tl.constexpr):
+    expert=tl.program_id(0)
+    slots=tl.arange(0,BR)
+    ids=tl.load(Ids+slots,slots<R,other=-1)
+    valid=ids==expert
+    rank=tl.cumsum(valid.to(tl.int32),0)-1
+    tl.store(Buckets+expert*R+rank,slots,mask=valid)
+    tl.store(Counts+expert,tl.sum(valid.to(tl.int32),0))
+
+@triton.jit
+def _pack(Buckets,Counts,Sorted,Experts,Padded,R:tl.constexpr,E:tl.constexpr,BE:tl.constexpr,BM:tl.constexpr, BW:tl.constexpr):
+    tile=tl.program_id(0)
+    es=tl.arange(0,BE)
+    counts=tl.load(Counts+es,es<E,other=0)
+    ends=tl.cumsum(tl.cdiv(counts,BM),0)
+    total=tl.max(ends,0)
+    if tile==0:
+        tl.store(Padded,total*BM)
+    if tile<total:
+        expert=tl.sum((ends<=tile).to(tl.int32),0)
+        begin=tl.max(tl.where(es<expert,ends,0),0)
+        count=tl.sum(tl.where(es==expert,counts,0),0)
+        offset=tl.arange(0,BW)
+        rank=(tile-begin)*BM+offset
+        slots=tl.load(Buckets+expert*R+rank,rank<count,other=R)
+        tl.store(Sorted+tile*BM+offset,slots,offset<BM)
+        tl.store(Experts+tile,expert)
+
+def moe_align_block_size(ids, block_size, num_experts, ignore_invalid_experts=True):
+    assert ignore_invalid_experts and ids.is_contiguous()
+    rows=ids.numel()
+    blocks=min(rows,triton.cdiv(rows+num_experts*(block_size-1),block_size))
+    opts={"dtype":torch.int32,"device":ids.device}
+    sorted_ids=torch.empty(blocks*block_size,**opts)
+    experts=torch.empty(blocks,**opts)
+    padded=torch.empty(1,**opts)
+    if ids.shape[0]==1:
+        _one[(1,)](ids,sorted_ids,experts,padded,rows,block_size,triton.next_power_of_2(block_size))
+    elif ids.shape[0] <= min(8,block_size) and rows <= 64:
+        # Top-k contains distinct experts in every token, so one block holds
+        # every slot for an expert in this batch.
+        pack_verify[(1,)](ids,sorted_ids,experts,padded,rows,num_experts,block_size,
+                          triton.next_power_of_2(rows),triton.next_power_of_2(block_size),num_warps=4)
+    else:
+        buckets=torch.empty((num_experts,rows),**opts)
+        counts=torch.empty(num_experts,**opts)
+        _group[(num_experts,)](ids,buckets,counts,rows,triton.next_power_of_2(rows))
+        _pack[(blocks,)](buckets,counts,sorted_ids,experts,padded,rows,num_experts,triton.next_power_of_2(num_experts),block_size,triton.next_power_of_2(block_size))
+    return sorted_ids,experts,padded
