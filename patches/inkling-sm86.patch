+"""Software E4M3FN cache conversion for Ampere, with ties-to-even rounding."""
+from vllm.triton_utils import tl, triton
+
+@triton.jit
+def encode(x):
+    x=x.to(tl.float32)
+    mag=tl.minimum(tl.abs(x),448.0)
+    exp=((mag.to(tl.uint32,bitcast=True)>>23).to(tl.int32)-127)
+    exp=tl.maximum(exp,-6)
+    step=((exp+124)<<23).to(tl.float32,bitcast=True)
+    significand=tl.extra.cuda.libdevice.rint(mag/step).to(tl.int32)
+    code=((exp+6)*8+significand).to(tl.uint32)
+    sign=(x.to(tl.uint32,bitcast=True)>>24)&128
+    return (sign|tl.where(x!=x,127,code)).to(tl.uint8)
+
+@triton.jit
+def decode(bits):
+    bits=bits.to(tl.uint32)
+    mag=bits&127
+    half=((mag<<7)+8192).to(tl.uint16).to(tl.float16,bitcast=True)
+    absolute=tl.where(mag<8,mag.to(tl.float32)*(1./512.),half.to(tl.float32))
+    absolute=tl.where(mag==127,float("nan"),absolute)
+    return tl.where((bits&128)!=0,-absolute,absolute)
