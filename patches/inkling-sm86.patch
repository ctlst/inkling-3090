+"""Pack short verification batches for Humming in one CTA on SM86."""
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit
+def _maximum(a, b):
+    return tl.maximum(a, b)
+
+
+@triton.jit
+def pack_verify(Ids, Sorted, Experts, Padded, R: tl.constexpr, E: tl.constexpr,
+                BM: tl.constexpr, BR: tl.constexpr, BW: tl.constexpr):
+    lane = tl.arange(0, BR)
+    ids = tl.load(Ids + lane, lane < R, -1)
+    # Sort by expert, then original routing slot. Padding sorts after all experts.
+    ordered = tl.sort(tl.where(ids >= 0, ids, E) * BR + lane, descending=False)
+    expert = ordered // BR
+    valid = expert < E
+    prev = tl.gather(expert, tl.maximum(lane - 1, 0), 0)
+    nxt = tl.gather(expert, tl.minimum(lane + 1, BR - 1), 0)
+    starts = valid & ((lane == 0) | (expert != prev))
+    ends = valid & ((lane == BR - 1) | (expert != nxt))
+    block = tl.cumsum(starts.to(tl.int32), 0) - 1
+    start_lane = tl.associative_scan(tl.where(starts, lane, 0), 0, _maximum)
+    rank = lane - start_lane
+    tl.store(Sorted + block * BM + rank, ordered % BR, valid)
+    tl.store(Experts + block, expert, starts)
+    offset = tl.arange(0, BW)
+    tl.store(Sorted + block[:, None] * BM + offset[None, :], R,
+             ends[:, None] & (offset[None, :] > rank[:, None]) & (offset[None, :] < BM))
+    tl.store(Padded, tl.sum(starts.to(tl.int32), 0) * BM)
