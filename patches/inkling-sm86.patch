+"""SM86 full-attention prefill for a single request with a paged E4M3 cache."""
+import torch
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit
+def _expand(bits):
+    # Position sign/exponent/fraction as FP16 with the E4M3 bias still in place.
+    # Multiplication by 2**8 corrects the bias, including FP8 subnormals.
+    u = bits.to(tl.uint16)
+    half = (((u & 127) << 7) | ((u & 128) << 8)).to(tl.float16, bitcast=True)
+    scaled = half * 256.0
+    return tl.where((u & 127) == 127, float("nan"), scaled).to(tl.bfloat16)
+
+
+@triton.jit
+def _partial(Q, K, V, Rel, Table, Out, LogZ, past, length, scale,
+             qt: tl.constexpr, qh: tl.constexpr, kb: tl.constexpr, ks: tl.constexpr,
+             kh: tl.constexpr, rs: tl.constexpr, rh: tl.constexpr,
+             T: tl.constexpr, H: tl.constexpr, G: tl.constexpr, D: tl.constexpr,
+             PAGE: tl.constexpr, EXTENT: tl.constexpr, S: tl.constexpr,
+             BM: tl.constexpr, BN: tl.constexpr, WINDOW: tl.constexpr,
+             LS: tl.constexpr, LT: tl.constexpr):
+    tile = tl.program_id(0)
+    head = tl.program_id(1)
+    part = tl.program_id(2)
+    t = tile * BM + tl.arange(0, BM)
+    d = tl.arange(0, D)
+    n = tl.arange(0, BN)
+    q = tl.load(Q + t[:, None] * qt + head * qh + d[None, :], t[:, None] < T, 0)
+    pos = past + t
+    shear_end = tl.minimum((t // 128 + 1) * 128, T)
+    rel_base = tl.cdiv(past + shear_end, 128) * 128 - (EXTENT + 256)
+    rel = Rel + t * rs + head * rh - rel_base
