+"""Evaluate a dense FA2 prefix with the original relative-bias tail on SM86."""
+import torch
+from vllm.triton_utils import triton, tl
+from vllm.vllm_flash_attn import flash_attn_varlen_func
+from vllm.models.inkling2.nvidia.ops.attention_sm90 import MODE_OUT_LSE, rel_attention
+from vllm.models.inkling2.nvidia.ops.kv_sm86 import decode
+
+
+@triton.jit
+def _unpack(K, V, Table, Buf, start, N: tl.constexpr, PAGE: tl.constexpr,
+            H: tl.constexpr, D: tl.constexpr, KB: tl.constexpr, KS: tl.constexpr,
+            KH: tl.constexpr, B: tl.constexpr):
+    t = tl.program_id(0) * B + tl.arange(0, B)
+    h = tl.program_id(1)
+    d = tl.arange(0, D)
+    page = tl.load(Table + (start + t) // PAGE)
+    # Serving block IDs can land beyond 2 GiB in the shared FP8 allocation.
+    off = (page.to(tl.int64) * KB + ((start+t) % PAGE)*KS + h*KH)[:, None] + d[None, :]
+    dest = (t*H*D + h*D)[:, None] + d[None, :]
+    tl.store(Buf + dest, decode(tl.load(K + off)))
+    tl.store(Buf + N*H*D + dest, decode(tl.load(V + off)))
+
+
+@triton.jit
+def _join(F, Z, Near, NZ, old_stride, old_token, T: tl.constexpr, H: tl.constexpr,
+          D: tl.constexpr, S: tl.constexpr, BS: tl.constexpr,
+          ZH: tl.constexpr, ZT: tl.constexpr):
+    t = tl.program_id(0)
+    h = tl.program_id(1)
+    s = tl.arange(0, BS)
+    d = tl.arange(0, D)
+    z = tl.load(Z+h*ZH+(s*T+t)*ZT, s<S, -float('inf'))
+    oldz = tl.load(NZ+h*old_stride+t*old_token)
+    m = tl.maximum(tl.max(z,0), oldz)
+    w = tl.exp(z-m)
+    ow = tl.exp(oldz-m)
+    denom = tl.sum(w,0)+ow
+    f = tl.load(F + (((s*T+t)*H+h)*D)[:,None]+d[None,:], (s<S)[:,None], 0).to(tl.float32)
+    near = tl.load(Near + (t*H+h)*D+d)
+    tl.store(Near+(t*H+h)*D+d, (tl.sum(f*w[:,None],0)+near*ow)/denom)
+    tl.store(NZ+h*old_stride+t*old_token, m+tl.log(denom))
+
+
+def hybrid(q,k,v,out,lse,rel,table,length,scale,cu,seq,block=2048,group=8):
+    t,h,d=q.shape
+    extent=rel.shape[2]-256
+    far=max(0,(length-t-extent+1)//block*block)
+    rel_attention(q,k,v,out,lse,rel,block_table=table[:,far//k.shape[1]:],
+                  cache_seqlens=seq-far,cu_seqlens_q=cu,max_query_len=t,
+                  softmax_scale=scale,window=0,num_splits=1,mode=MODE_OUT_LSE)
+    for start in range(0,far,block*group):
+        n=min(block*group,far-start)
+        s=n//block
+        buf=torch.empty((2,n,k.shape[2],d),dtype=q.dtype,device=q.device)
+        _unpack[(n//8,k.shape[2])](k,v,table,buf,start,n,k.shape[1],k.shape[2],d,*k.stride()[:3],8)
+        cq=torch.arange(s+1,device=q.device,dtype=torch.int32)*t
+        ck=torch.arange(s+1,device=q.device,dtype=torch.int32)*block
+        f,z=flash_attn_varlen_func(q.repeat(s,1,1),buf[0],buf[1],t,cq,block,cu_seqlens_k=ck,
+                                   softmax_scale=scale,causal=False,fa_version=2,return_softmax_lse=True)
+        assert z.shape==(h,s*t), z.shape
+        _join[(t,h)](f,z,out,lse,*lse.stride(),t,h,d,s,triton.next_power_of_2(s),*z.stride())
